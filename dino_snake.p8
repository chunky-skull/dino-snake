pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--init

cs=64--center screen
mflg=1--map flag
fflg=2--food flag

--character
ch={
	x=0,
	y=0,
	h=8,
	w=8,
	dx=0,
	dy=0,
	sp=1,--speed
	m_sp=5,--max speed
	acc=0.5,--acceleration
	--sprite
	sr={
		n=2,--number
		sc=1,--scale
		fl_x=false,--flip
		fl_y=false
	},
	--state
	st={
		idl=false,--idle
		--run
		rn_l=false,
		rn_r=false,
		rn_u=false,
		rn_d=false,
		eat=false
	}
}

frt=0.70--friction
grv=0--gravity

--camera animation settings
canm = {
	--speed
	sp=0,
	--dampening
	dm=0,
	--shake
	sh=0
}

function _init()
	--set up egg animation for
	--player to spawn in
	ch.x=cs-4
	ch.y=cs+2
end
-->8
--update
function _update()
	--chupdate()--character update
end

function _draw()
	cls()
	map(0,0)
	chupdate()
	chdraw()--character draw
end
-->8
--player chacter

function chupdate()--character update
	mv_ch(i_c())
end

function chdraw()--character draw
	spr(
		ch.sr.n,
		ch.x,
		ch.y,
		1,
		1,
		ch.sr.fl_x,
		ch.sr.fl_y
	)
end

function ch_ls(n,m)--limit character speed
	return mid(-m,n,m)
end

function mv_ch(i)--move character
	pys(ch)
	for mv in pairs(ch.st) do
		ch.st[mv]=false
		if(mv==i)then
			ch.st[mv] = true
			if(mv=="eat")then
				--eat
			end
			if(mv=="rn_l")then
				rn_l()
			elseif(mv=="rn_r")then
				rn_r()
			elseif(mv=="rn_u") then
				rn_u()
			elseif(mv=="rn_d")then
				rn_d()
			end
		end
	end
	ch.x+=ch.dx
	ch.y+=ch.dy
end

function rn_l()
	--set sprite
	ch.sr.n=2
	ch.sr.fl_x=true
	local hb_v={
		x1=ch.x-1,
		y1=ch.y+5,
		x2=ch.x,
		y2=ch.y+ch.h-1
	}
	if is_col(hb_v,mflg)then
		ch.dx=0
	else
		ch.dx-=ch.acc
		ch.dx=ch_ls(ch.dx,ch.m_sp)
	end
end
function rn_r()
	ch.sr.n=2
	ch.sr.fl_x=false
	local hb_v={
		x1=ch.x+ch.w-1,
		y1=ch.y+5,
		x2=ch.x+ch.w,
		y2=ch.y+ch.h-1
	}
	if is_col(hb_v,mflg)then
		ch.dx=0
	else
		ch.dx+=ch.acc
		ch.dx=ch_ls(ch.dx,ch.m_sp)
	end
end
function rn_u()
	ch.sr.n=34
	local hb_v={
		x1=ch.x+1,
		y1=ch.y+3,
		x2=ch.x+ch.w-3,
		y2=ch.y+3
	}
	if is_col(hb_v,mflg)then
		ch.dy=0
	else
		ch.dy-=ch.acc
		ch.dy=ch_ls(ch.dy,ch.m_sp)
	end
end
function rn_d()
	ch.sr.n=18
	local hb_v={
		x1=ch.x+2,
		y1=ch.y+ch.h,
		x2=ch.x+ch.w-3,
		y2=ch.y+ch.h
	}
	if is_col(hb_v,mflg)then
		ch.dy=0
	else
		ch.dy+=ch.acc
		ch.dy=ch_ls(ch.dy,ch.m_sp)
	end
end
-->8
--functions

function i_c()--input collector
	local i="idl" 
	if btn(0) then
		i="rn_l"
	end
	if btn(1) then
		i="rn_r"
	end
	if btn(2) then
		i="rn_u"
	end
	if btn(3) then
		i="rn_d"
	end
	if btn(4) then
	end
	if btnp(5) then
		i="eat"
	end
	return i
end

function pys(g_o)--physics
	g_o.dx*=frt
	g_o.dy*=frt
end
--is collision
function is_col(hb_v,flg)
	local x1=hb_v.x1/8
	local x2=hb_v.x2/8
	local y1=hb_v.y1/8
	local y2=hb_v.y2/8
	--dev
	rectfill(
		hb_v.x1,
		hb_v.y1,
		hb_v.x2,
		hb_v.y2,
		7
	)
	if fget(mget(x1,y1),flg)
	or fget(mget(x1,y2),flg)
	or fget(mget(x2,y1),flg)
	or fget(mget(x2,y2),flg)then
		return true
	else
		return false
	end
end

