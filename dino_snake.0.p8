--functions
	--get current hitbox vector
function hbvget(obj,osv)
	--object --offset vector
	return {
		x1=(obj.x+osv.x1)+obj.vx,
		y1=(obj.y+osv.y1)+obj.vy,
		x2=(obj.x+osv.x2)+obj.vx,
		y2=(obj.y+osv.y2)+obj.vy,
	}
end
function pys(obj,vk,hbv)--physics
	--vk veolcity key
	obj[vk]*=frc
	--map collisions
	mpcol(obj,hbv)
end
--move and slide
function mvsld(obj)
	--obj.vx*=frc
	--obj.vy*=frc
	local hbv
	if obj.vx<0 then
		hbv={
			x1=-1,
			y1=0,
			x2=-1,
			y2=obj.h
		}
		hbv=hbvget(obj,hbv)
		pys(obj,"vx",hbv)
	end
	if obj.vx>0 then
		hbv={
			x1=obj.w+1,
			y1=0,
			x2=obj.w+1,
			y2=obj.h
		}
		hbv=hbvget(obj,hbv)
		pys(obj,"vx",hbv)
	end
	if obj.vy<0 then
		hbv={
			x1=0,
			y1=-1,
			x2=obj.w,
			y2=-1
		}
		hbv=hbvget(obj,hbv)
		pys(obj,"vy",hbv)
	end
	if obj.vy>0 then
		hbv={
			x1=0,
			y1=obj.h+1,
			x2=obj.w,
			y2=obj.h+1
		}
		hbv=hbvget(obj,hbv)
		pys(obj,"vy",hbv)
	end
	obj.x+=obj.vx
	obj.y+=obj.vy
end
--is collison
function iscol(hbv,flg)
	local x1=hbv.x1/8
	local x2=hbv.x2/8
	local y1=hbv.y1/8
	local y2=hbv.y2/8
	--dev
	rectfill(
		hbv.x1,
		hbv.y1,
		hbv.x2,
		hbv.y2,
		7
	)
	--x1 y1 top left corner
	if fget(mget(x1,y1),flg)
	--x1 y2 bottom left corner
	or fget(mget(x1,y2),flg)
	--x2 y1 top right corner
	or fget(mget(x2,y1),flg)
	--x2 y2 bottom right corner
	or fget(mget(x2,y2),flg)then
		return true
	end
	local xtl=(hbv.x2-hbv.x1)/8
	local ytl=(hbv.y2-hbv.y1)/8
	local lp=0
	local cx=x1
	local cy=y1
	if xtl>1 then
		--msg="xtl triggered: "..char.w
		while lp!=xtl do
			if fget(mget(cx,y1),flg)
			or fget(mget(cx,y2),flg)then
				return true
			end
			lp+=1
			cx+=1
		end
	end
	lp=0
	if ytl>1 then
	--msg="ytl triggered: "..ytl
		while lp!=ytl do
			if fget(mget(x1,cy),flg)
			or fget(mget(x2,cy),flg)then
					return true
			end
			lp+=1
			cy+=1
		end
	end
		return false
end
--map collision
function mpcol(obj,hbv)
	local vx=abs(obj.vx)
	local vy=abs(obj.vy)
	local nhbv=hbv
	if iscol(nhbv,mflg) then
		if vx>0 then
			obj.vx=0
		elseif vy>0 then
			obj.vy=0
		end
	end
end

function ismpcol(x1,y1,h,w)
	local x2 = x1+w/8
	local y2 = y1+h/8
	x1/=8
	y1/=8
	return fget(mget(x1,y1),mflg)
	or fget(mget(x1,y2),mflg)
	or fget(mget(x2,y1),mflg)
	or fget(mget(x2,y2),mflg)
end
